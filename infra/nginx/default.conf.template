# API gateway: serves the built React app and proxies /api and /admin to Django.
# TLS terminates here in production (or at the load balancer in front of it).
# This is an nginx template: ${CSP_*} variables are filled in from the environment at container start.

# Behind the AWS load balancer, $remote_addr would be the balancer for everyone, so per-IP rate limits would
# lump all users together. Trust X-Forwarded-For only from the balancer's network (the VPC CIDR in AWS).
set_real_ip_from ${TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;

# Presigning (POST /api/videos/) gets its own limit. An empty key isn't counted, so other API calls don't touch it.
map "$request_method:$uri" $presign_client {
    default "";
    "POST:/api/videos/" $binary_remote_addr;
}
limit_req_zone $presign_client zone=presign:10m rate=10r/m;

# Behind a load balancer, keep the protocol the client actually used (Django redirects to HTTPS on it).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# One JSON object per request, carrying the same request id Django logs.
log_format json escape=json '{"ts":"$time_iso8601","service":"nginx","request_id":"$request_id",'
    '"method":"$request_method","path":"$uri","status":$status,"bytes":$body_bytes_sent,'
    '"duration_ms":$request_time,"upstream_ms":"$upstream_response_time",'
    '"ip":"$remote_addr","user_agent":"$http_user_agent"}';
access_log /var/log/nginx/access.log json;

server {
    listen 80;
    server_name _;
    # Docker's DNS. nginx would otherwise look a container's address up once, at start, and keep calling the old one
    # after that container is replaced. This only applies where proxy_pass uses a variable.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $django_upstream http://django:8000;
    client_max_body_size 10m;  # video bytes go straight to S3, never through here
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    location ~ ^/api/auth/(login|register)/ {
        limit_req zone=auth burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/proxy_django.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req zone=presign burst=5 nodelay;
        limit_req_status 429;
        include /etc/nginx/proxy_django.conf;
    }

    location /admin/ {
        include /etc/nginx/proxy_django.conf;
    }

    location /static/ {
        include /etc/nginx/proxy_django.conf;
    }

    # Local development adds the /cdn/ stand-in here (infra/nginx/local-cdn.conf, mounted by Compose).
    include /etc/nginx/extra/*.conf;

    # Hashed build assets never change.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        include /etc/nginx/security_headers.conf;
    }

    # SPA fallback: unknown paths go to React Router.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/security_headers.conf;
        # hls.js plays through MediaSource (blob: media) and may use a blob: worker.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: ${CSP_MEDIA_ORIGINS}; media-src 'self' blob: ${CSP_MEDIA_ORIGINS}; connect-src 'self' ${CSP_MEDIA_ORIGINS} ${CSP_UPLOAD_ORIGINS} ${CSP_CONNECT_EXTRA}; worker-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}
