# Copy to .env for local development. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Local runs over plain http, so the refresh cookie can't be Secure. Always true in prod.
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming-local-password

# Local S3 (SeaweedFS) credentials; IAM roles in AWS (no keys in prod).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-local-secret
S3_BUCKET=streaming-media

# Presigned URLs must point at an address the browser can reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Playback CDN (local stand-in served by nginx; CloudFront URL in AWS).
CDN_BASE_URL=http://localhost:8080/cdn

# MongoDB (MongoDB Atlas in AWS).
MONGO_ROOT_USER=streaming
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=streaming

# Data stack (docker compose --profile data). Superset login: admin / SUPERSET_ADMIN_PASSWORD.
ANALYTICS_ETL_PASSWORD=change-me
ANALYTICS_RO_PASSWORD=change-me
AIRFLOW_JWT_SECRET=change-me
SUPERSET_SECRET_KEY=change-me
SUPERSET_ADMIN_PASSWORD=change-me

# ML worker (docker compose --profile ml): its own database role, limited to the results tables.
# Leave empty if you don't run it: once set, the monitor expects the worker to be consuming.
ML_WORKER_DB_PASSWORD=

# Big data stack (docker compose --profile data --profile bigdata). Leave empty if you don't run it.
# spark: aggregate from the data lake instead of MongoDB. Build the lake first: see "Big data" in the README.
ANALYTICS_ENGINE=
# Once set, the monitor expects Kafka Connect to be consuming.
LAKE_SINK_ENABLED=
# redis://redis:6379/0 to show live numbers on the site. Without it the site simply doesn't show them.
REDIS_URL=
# Optional: where the daily pipeline posts failures (a Slack or Discord incoming webhook).
ALERT_WEBHOOK_URL=
