# Copy to .env for local development. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Local runs over plain http, so the refresh cookie can't be Secure. Always true in prod.
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming-local-password

# Local S3 (SeaweedFS) credentials; IAM roles in AWS (no keys in prod).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin-local-secret
S3_BUCKET=streaming-media

# Presigned URLs must point at an address the browser can reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Playback CDN (local stand-in served by nginx; CloudFront URL in AWS).
CDN_BASE_URL=http://localhost:8080/cdn

# MongoDB (MongoDB Atlas in AWS).
MONGO_ROOT_USER=streaming
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=streaming
